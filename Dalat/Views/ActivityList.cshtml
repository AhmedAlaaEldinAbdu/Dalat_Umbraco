@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = Context.Request.Cookies["lang"] ?? "ar";
    if (lang != "ar" && lang != "en") lang = "ar";
    var isEn = lang == "en";
    var dir  = isEn ? "ltr" : "rtl";
    var culture = isEn ? "en-US" : "ar-SA";

    ViewData["Lang"]  = lang;
    ViewData["Dir"]   = dir;

    var pageTitle = Model.Value<string>("pageTitle", culture: culture) ?? (isEn ? "Activities" : "الفعاليات");
    var subtitle  = Model.Value<string>("subtitle",  culture: culture) ?? "";
    ViewData["Title"] = pageTitle + (isEn ? " – Dalat School" : " – مدارس دالات");

    // Search & filter
    var search    = Context.Request.Query["q"].ToString().Trim();
    var filterLoc = Context.Request.Query["loc"].ToString().Trim();
    var filterAud = Context.Request.Query["aud"].ToString().Trim();

    const int pageSize = 10;
    int currentPage = 1;
    int.TryParse(Context.Request.Query["page"], out currentPage);
    if (currentPage < 1) currentPage = 1;

    var allItems = Model.Children
        .Where(c => c.ContentType.Alias == "activityItem" && c.IsPublished())
        .OrderByDescending(c => c.Value<DateTime>("startDate"))
        .ToList();

    // Apply filters
    if (!string.IsNullOrEmpty(search))
        allItems = allItems.Where(c => (c.Value<string>("pageTitle", culture: culture) ?? c.Name)
            .Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
    if (!string.IsNullOrEmpty(filterLoc))
        allItems = allItems.Where(c => (c.Value<string>("eventLocation", culture: culture) ?? "")
            .Contains(filterLoc, StringComparison.OrdinalIgnoreCase)).ToList();
    if (!string.IsNullOrEmpty(filterAud))
        allItems = allItems.Where(c => (c.Value<string>("targetAudience", culture: culture) ?? "")
            .Contains(filterAud, StringComparison.OrdinalIgnoreCase)).ToList();

    int totalItems = allItems.Count;
    int totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
    if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
    var pageItems = allItems.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    string baseUrl = Context.Request.Path;
}

<!-- HEADER -->
<section class="ajb-header" dir="@dir">
    <div class="ajb-headerInner">
        <h1 class="ajb-pageTitle">@pageTitle</h1>
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="ajb-pageSubtitle">@subtitle</p>
        }
    </div>
</section>

<!-- SEARCH BAR -->
<div class="act-searchBar" dir="@dir">
    <form method="get" action="@baseUrl" class="act-searchForm">
        <input type="text" name="q"   value="@search"    placeholder="@(isEn ? "Search..." : "بحث...")"          class="act-searchInput" />
        <input type="text" name="loc" value="@filterLoc" placeholder="@(isEn ? "Location..." : "الموقع...")"      class="act-searchInput" />
        <input type="text" name="aud" value="@filterAud" placeholder="@(isEn ? "Audience..." : "الفئة المستهدفة...")" class="act-searchInput" />
        <button type="submit" class="act-searchBtn">@(isEn ? "Search" : "بحث")</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(filterLoc) || !string.IsNullOrEmpty(filterAud))
        {
            <a href="@baseUrl" class="act-clearBtn">@(isEn ? "Clear" : "مسح")</a>
        }
    </form>
</div>

<!-- GRID -->
<section class="act-section" dir="@dir">
    <div class="act-grid">
        @if (!pageItems.Any())
        {
            <p class="act-empty">@(isEn ? "No activities found." : "لا توجد فعاليات.")</p>
        }
        else
        {
            foreach (var item in pageItems)
            {
                var title    = item.Value<string>("pageTitle",      culture: culture) ?? item.Name;
                var audience = item.Value<string>("targetAudience", culture: culture) ?? "";
                var location = item.Value<string>("eventLocation",  culture: culture) ?? "";
                var isLocal  = item.Value<bool>("isLocalEvent");
                var startDt  = item.Value<DateTime?>("startDate");
                var endDt    = item.Value<DateTime?>("endDate");
                var cover    = item.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("coverImage");
                var coverUrl = cover?.MediaUrl();
                var fmt      = "dd MMM yyyy";
                var startStr = startDt.HasValue ? startDt.Value.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture) : "";
                var endStr   = endDt.HasValue   ? endDt.Value.ToString(fmt,   System.Globalization.CultureInfo.InvariantCulture) : "";

                <div class="act-card">
                    <!-- Logo -->
                    <div class="act-cardLogo">
                        @if (!string.IsNullOrEmpty(coverUrl))
                        {
                            <img src="@coverUrl" alt="@title" />
                        }
                        else
                        {
                            <img src="/logos/dalat-logo.png" alt="@title" class="act-logoDefault" />
                        }
                        <span class="act-localBadge @(isLocal ? "act-badgeLocal" : "act-badgeIntl")">
                            @(isLocal ? (isEn ? "Local" : "محلي") : (isEn ? "International" : "دولي"))
                        </span>
                    </div>

                    <!-- Info -->
                    <div class="act-cardBody" style="text-align:@(isEn?"left":"right")">
                        <h2 class="act-cardTitle">@title</h2>

                        @if (!string.IsNullOrEmpty(audience))
                        {
                            <div class="act-cardTag">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                <span>@(isEn ? "Audience:" : "الفئة المستهدفة:") @audience</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(location))
                        {
                            <div class="act-cardTag">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                <span>@(isEn ? "Location:" : "موقع الحدث:") @location</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(startStr))
                        {
                            <div class="act-cardTag">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                <span>@(isEn ? "From:" : "من:") @startStr @(!string.IsNullOrEmpty(endStr) ? (isEn ? " – To: " : " – الى: ") + endStr : "")</span>
                            </div>
                        }
                    </div>

                    <!-- Footer -->
                    <div class="act-cardFooter">
                        <a href="@item.Url()" class="act-detailBtn">@(isEn ? "Details" : "التفاصيل")</a>
                    </div>
                </div>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="nws-pagination" dir="@dir">
            @if (currentPage > 1)
            {
                <a href="@baseUrl?page=@(currentPage-1)" class="nws-pgBtn">@(isEn?"‹ Prev":"السابق ›")</a>
            }
            else { <span class="nws-pgBtn nws-pgDisabled">@(isEn?"‹ Prev":"السابق ›")</span> }

            @{ int sp = Math.Max(1,currentPage-2); int ep = Math.Min(totalPages,currentPage+2); }
            @if (sp > 1) { <a href="@baseUrl?page=1" class="nws-pgBtn">1</a> }
            @if (sp > 2) { <span class="nws-pgEllipsis">…</span> }
            @for (int p = sp; p <= ep; p++)
            {
                if (p == currentPage) { <span class="nws-pgBtn nws-pgActive">@p</span> }
                else { <a href="@baseUrl?page=@p" class="nws-pgBtn">@p</a> }
            }
            @if (ep < totalPages-1) { <span class="nws-pgEllipsis">…</span> }
            @if (ep < totalPages)   { <a href="@baseUrl?page=@totalPages" class="nws-pgBtn">@totalPages</a> }

            @if (currentPage < totalPages)
            {
                <a href="@baseUrl?page=@(currentPage+1)" class="nws-pgBtn">@(isEn?"Next ›":"‹ التالي")</a>
            }
            else { <span class="nws-pgBtn nws-pgDisabled">@(isEn?"Next ›":"‹ التالي")</span> }
        </nav>
    }
</section>