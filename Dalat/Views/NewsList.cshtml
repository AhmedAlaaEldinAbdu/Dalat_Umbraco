@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = Context.Request.Cookies["lang"] ?? "ar";
    if (lang != "ar" && lang != "en") lang = "ar";
    var isEn = lang == "en";
    var dir  = isEn ? "ltr" : "rtl";
    var culture = isEn ? "en-US" : "ar-SA";

    ViewData["Lang"]  = lang;
    ViewData["Dir"]   = dir;

    var pageTitle = Model.Value<string>("pageTitle", culture: culture)
                 ?? (isEn ? "News" : "الأخبار");

    var subtitle = Model.Value<string>("subtitle", culture: culture)
                ?? (isEn ? "Latest news and updates" : "آخر الأخبار والمستجدات");

    ViewData["Title"] = pageTitle + (isEn ? " – Dalat School" : " – مدارس دالات");

    const int pageSize = 10;
    int currentPage = 1;
    int.TryParse(Context.Request.Query["page"], out currentPage);
    if (currentPage < 1) currentPage = 1;

    var allItems = Model.Children
        .Where(c => c.ContentType.Alias == "newsItem" && c.IsPublished())
        .OrderByDescending(c => c.Value<DateTime>("publishDate"))
        .ToList();

    int totalItems = allItems.Count;
    int totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
    if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

    var newsItems = allItems.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    string baseUrl = Context.Request.Path;
}

<!-- PAGE HEADER -->
<section class="ajb-header" dir="@dir">
    <div class="ajb-headerInner">
        <h1 class="ajb-pageTitle">@pageTitle</h1>
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="ajb-pageSubtitle">@subtitle</p>
        }
    </div>
</section>

<!-- NEWS GRID -->
<section class="nws-section" dir="@dir">
    <div class="nws-grid">
        @if (!newsItems.Any())
        {
            <p class="nws-empty">@(isEn ? "No news available at the moment." : "لا توجد أخبار متاحة في الوقت الحالي.")</p>
        }
        else
        {
            foreach (var item in newsItems)
            {
                var title   = item.Value<string>("pageTitle", culture: culture) ?? item.Name;
                var summary = item.Value<string>("summary", culture: culture) ?? "";
                var pubDate = item.Value<DateTime?>("publishDate");
                var dateStr = pubDate.HasValue
                    ? pubDate.Value.ToString("dd MMMM yyyy",
                        new System.Globalization.CultureInfo(isEn ? "en-US" : "ar-SA"))
                    : string.Empty;

                var thumb    = item.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("thumbnail");
                var thumbUrl = thumb?.MediaUrl();
                var hasCover = !string.IsNullOrEmpty(thumbUrl);

                <a href="@item.Url()" class="nws-card" style="text-decoration:none;">
                    <div class="nws-cardImage @(hasCover ? "" : "nws-cardImageDefault")">
                        <img src="@(hasCover ? thumbUrl : "/logos/dalat-logo.png")" alt="@title" loading="lazy" />
                    </div>
                    <div class="nws-cardBody" style="text-align:@(isEn ? "left" : "right")">
                        <h2 class="nws-cardTitle">@title</h2>
                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <p class="nws-cardSummary">@summary</p>
                        }
                    </div>
                    <div class="nws-cardFooter" style="flex-direction:@(isEn ? "row" : "row-reverse")">
                        @if (!string.IsNullOrEmpty(dateStr))
                        {
                            <span class="nws-date">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                @dateStr
                            </span>
                        }
                        <span class="nws-readMore">@(isEn ? "Read more" : "اقرأ المزيد")</span>
                    </div>
                </a>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="nws-pagination" dir="@dir">
            @if (currentPage > 1)
            {
                <a href="@baseUrl?page=@(currentPage - 1)" class="nws-pgBtn">@(isEn ? "‹ Prev" : "السابق ›")</a>
            }
            else
            {
                <span class="nws-pgBtn nws-pgDisabled">@(isEn ? "‹ Prev" : "السابق ›")</span>
            }

            @{ int startPg = Math.Max(1, currentPage - 2); int endPg = Math.Min(totalPages, currentPage + 2); }
            @if (startPg > 1) { <a href="@baseUrl?page=1" class="nws-pgBtn">1</a> }
            @if (startPg > 2) { <span class="nws-pgEllipsis">…</span> }

            @for (int p = startPg; p <= endPg; p++)
            {
                if (p == currentPage) { <span class="nws-pgBtn nws-pgActive">@p</span> }
                else                  { <a href="@baseUrl?page=@p" class="nws-pgBtn">@p</a> }
            }

            @if (endPg < totalPages - 1) { <span class="nws-pgEllipsis">…</span> }
            @if (endPg < totalPages)     { <a href="@baseUrl?page=@totalPages" class="nws-pgBtn">@totalPages</a> }

            @if (currentPage < totalPages)
            {
                <a href="@baseUrl?page=@(currentPage + 1)" class="nws-pgBtn">@(isEn ? "Next ›" : "‹ التالي")</a>
            }
            else
            {
                <span class="nws-pgBtn nws-pgDisabled">@(isEn ? "Next ›" : "‹ التالي")</span>
            }
        </nav>
    }
</section>
