@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lang = Context.Request.Cookies["lang"] ?? "ar";
    if (lang != "ar" && lang != "en") lang = "ar";
    var isEn = lang == "en";
    var dir  = isEn ? "ltr" : "rtl";
    var culture = isEn ? "en-US" : "ar-SA";

    ViewData["Lang"] = lang;
    ViewData["Dir"]  = dir;

    var pageTitle = Model.Value<string>("pageTitle", culture: culture) ?? Model.Name;
    var bodyText  = Model.Value<Umbraco.Cms.Core.Strings.IHtmlEncodedString>("bodyText", culture: culture);
    var pubDate   = Model.Value<DateTime?>("publishDate") ?? Model.CreateDate;
    var thumb     = Model.Value<Umbraco.Cms.Core.Models.MediaWithCrops>("thumbnail");
    var imgUrl    = thumb?.MediaUrl();
    var dateStr   = pubDate.ToString("dd MMMM yyyy",
        new System.Globalization.CultureInfo(isEn ? "en-US" : "ar-SA"));

    var backUrl   = Model.Parent?.Url() ?? "/";
    var readAlso  = isEn ? "Read Also" : "اقرأ أيضا";

    // Related items: siblings excluding current, max 3
    var related = Model.Parent?.Children
        .Where(c => c.ContentType.Alias == "newsItem" && c.IsPublished() && c.Id != Model.Id)
        .OrderByDescending(c => c.Value<DateTime>("publishDate"))
        .Take(3)
        .ToList() ?? new List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>();

    ViewData["Title"] = pageTitle + (isEn ? " – Dalat School" : " – مدارس دالات");
}

<!-- ARTICLE -->
<article class="ni-article" dir="@dir">

    <!-- Header -->
    <div class="ni-header">
        <h1 class="ni-title" style="text-align:@(isEn?"left":"right")">@pageTitle</h1>
        @if (!string.IsNullOrEmpty(dateStr))
        {
            <div class="ni-meta" style="justify-content:@(isEn?"flex-start":"flex-end")">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span>@(isEn ? "Published on:" : "نشرت في:") @dateStr</span>
            </div>
        }
    </div>

    <!-- Thumbnail -->
    @if (!string.IsNullOrEmpty(imgUrl))
    {
        <div class="ni-thumbWrap">
            <img src="@imgUrl" alt="@pageTitle" class="ni-thumb" />
        </div>
    }

    <!-- Body -->
    <div class="ni-body" style="text-align:@(isEn?"left":"right")">
        @if (bodyText != null)
        {
            @bodyText
        }
    </div>

    <!-- Read Also -->
    @if (related.Any())
    {
        <div class="ni-readAlso" dir="@dir">
            <h2 class="ni-readAlsoTitle" style="text-align:@(isEn?"left":"right")">@readAlso</h2>
            <div class="ni-relatedGrid">
                @foreach (var item in related)
                {
                    var rTitle   = item.Value<string>("pageTitle", culture: culture) ?? item.Name;
                    var rSummary = item.Value<string>("summary", culture: culture) ?? "";
                    var rDate    = item.Value<DateTime?>("publishDate");
                    var rDateStr = rDate.HasValue
                        ? rDate.Value.ToString("dd MMMM yyyy",
                            new System.Globalization.CultureInfo(isEn ? "en-US" : "ar-SA"))
                        : string.Empty;

                    <a href="@item.Url()" class="ni-relCard" style="text-decoration:none;">
                        <div class="ni-relBody" style="text-align:@(isEn?"left":"right")">
                            <h3 class="ni-relTitle">@rTitle</h3>
                            @if (!string.IsNullOrWhiteSpace(rSummary))
                            {
                                <p class="ni-relSummary">@rSummary</p>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(rDateStr))
                        {
                            <div class="ni-relMeta" style="justify-content:@(isEn?"flex-start":"flex-end")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                                    <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                                </svg>
                                <span>@rDateStr</span>
                            </div>
                        }
                    </a>
                }
            </div>
        </div>
    }

</article>
