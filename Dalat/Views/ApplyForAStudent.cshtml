        'Father\'s Phone'             : 'جوال الأب',
        'Mother Phone number'         : 'جوال الأم',
        'MOTHER PHONE NUMBER'         : 'جوال الأم',
        'Mother\'s Phone'             : 'جوال الأم',
        'Email Address'               : 'البريد الإلكتروني',
        'EMAIL ADDRESS'               : 'البريد الإلكتروني',
        'Email'                       : 'البريد الإلكتروني',
        'EMAIL'                       : 'البريد الإلكتروني',
        'Branch'                      : 'الفرع',
        'BRANCH'                      : 'الفرع',
        'Academic Year'               : 'السنة الدراسية',
        'ACADEMIC YEAR'               : 'السنة الدراسية',
        'RegisterEducationalYear'     : 'السنة الدراسية',
        'Semester'                    : 'الفصل الدراسي',
        'SEMESTER'                    : 'الفصل الدراسي',
        'RegisterSemesterID'          : 'الفصل الدراسي',
        'Education System'            : 'النظام التعليمي',
        'EDUCATION SYSTEM'            : 'النظام التعليمي',
        'Grade'                       : 'الصف',
        'GRADE'                       : 'الصف',
        'RegisterGradeID'             : 'الصف',
        // Dropdown options — gender
        'Male'   : 'ذكر',
        'Female' : 'أنثى',
        // Dropdown options — guardian relation
        'Father' : 'الأب',
        'Mother' : 'الأم',
        'Uncle'  : 'العم',
        'Brother': 'الأخ',
        'Other'  : 'غير ذلك',
        // Dropdown options — nationality
        'Saudi'      : 'سعودي',
        'Egyptian'   : 'مصري',
        'Yemeni'     : 'يمني',
        'Syrian'     : 'سوري',
