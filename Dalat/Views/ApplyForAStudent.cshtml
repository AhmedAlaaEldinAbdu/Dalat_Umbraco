        'STUDENT INFORMATION'         : 'معلومات الطالب',
        'Guardian Information'        : 'معلومات ولي الأمر',
        'GUARDIAN INFORMATION'        : 'معلومات ولي الأمر',
        'Academic Information'        : 'المعلومات الأكاديمية',
        'ACADEMIC INFORMATION'        : 'المعلومات الأكاديمية',
        // Field labels
        'First Name'                  : 'الاسم الأول',
        'FIRST NAME'                  : 'الاسم الأول',
        'Student FIRST NAME'          : 'الاسم الأول للطالب',
        'STUDENT FIRST NAME'          : 'الاسم الأول للطالب',
        'Student Middle NAME'         : 'الاسم الثاني للطالب',
        'Student Middle Name'         : 'الاسم الثاني للطالب',
        'STUDENT MIDDLE NAME'         : 'الاسم الثاني للطالب',
        'Student Last NAME'           : 'اسم عائلة الطالب',
        'Student Last Name'           : 'اسم عائلة الطالب',
        'STUDENT LAST NAME'           : 'اسم عائلة الطالب',
        'Middle Name'                 : 'الاسم الثاني',
        'MIDDLE NAME'                 : 'الاسم الثاني',
        'Last Name'                   : 'اسم العائلة',
        'LAST NAME'                   : 'اسم العائلة',
        'National ID Number'          : 'رقم الهوية الوطنية',
        'NATIONAL ID NUMBER'          : 'رقم الهوية الوطنية',
        'Nationality'                 : 'الجنسية',
        'NATIONALITY'                 : 'الجنسية',
        'nationality'                 : 'الجنسية',
        'birthDate'                   : 'تاريخ الميلاد',
        'BirthDate'                   : 'تاريخ الميلاد',
        'Gender'                      : 'الجنس',
        'GENDER'                      : 'الجنس',
