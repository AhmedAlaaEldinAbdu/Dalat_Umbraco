        // Dropdown options — education system
        'General Education' : 'تعليم عام',
        // Placeholders
        'Enter your first name'   : 'أدخل الاسم الأول',
        'Enter your middle name'  : 'أدخل الاسم الثاني',
        'Enter your Middle name'  : 'أدخل الاسم الثاني',
        'Enter your last name'    : 'أدخل اسم العائلة',
        'Enter your Last name'    : 'أدخل اسم العائلة',
        'Enter your ID Number'    : 'أدخل رقم الهوية',
        'Enter your mobile number': 'أدخل رقم الجوال',
        'Enter your phone number' : 'أدخل رقم الهاتف',
        'Example: mail@domain.com': 'مثال: mail@domain.com',
        // Buttons
        'Submit'   : 'إرسال',
        'SUBMIT'   : 'إرسال',
        'Next'     : 'التالي',
        'NEXT'     : 'التالي',
        'Previous' : 'السابق',
        'PREVIOUS' : 'السابق',
        // Select prompt
        'Please select' : 'اختر...',
        '-- Select --'  : 'اختر...',
        'Select'        : 'اختر...',
        // Thank you
        'Thank you' : 'شكراً لك',
        'Thank You' : 'شكراً لك'
    };

    function translate(text) {
        if (!text) return null;
        var t = text.trim();
        // AR mode: English → Arabic. EN mode: keep as-is.
        return !isEn ? (enToAr[t] || null) : null;
    }

    function applyTranslations() {
        var wrap = document.querySelector('.ajb-formWrap');
        if (!wrap) return;

        // Section legends / headings
        wrap.querySelectorAll('legend, h2, h3, h4').forEach(function (el) {
            var tr = translate(el.textContent); if (tr) el.textContent = tr;
        });

        // Field labels (preserve child nodes like mandatory indicator *)
        wrap.querySelectorAll('label').forEach(function (el) {
            el.childNodes.forEach(function (node) {
                if (node.nodeType === 3) {
                    var tr = translate(node.textContent);
                    if (tr) node.textContent = node.textContent.replace(node.textContent.trim(), tr);
                }
            });
        });

        // Dropdown options
        wrap.querySelectorAll('select option').forEach(function (el) {
            var tr = translate(el.textContent); if (tr) el.textContent = tr;
        });

        // Placeholders
        wrap.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(function (el) {
            var tr = translate(el.getAttribute('placeholder')); if (tr) el.setAttribute('placeholder', tr);
        });

        // Submit / navigation buttons
        wrap.querySelectorAll('input[type="submit"]').forEach(function (el) {
            var tr = translate(el.value); if (tr) el.value = tr;
        });
        wrap.querySelectorAll('button').forEach(function (el) {
            var tr = translate(el.textContent); if (tr) el.textContent = tr;
        });

        wrap.setAttribute('dir', isEn ? 'ltr' : 'rtl');
    }

    function translateValidation() {
        var wrap = document.querySelector('.ajb-formWrap');
        if (!wrap) return;
        var msg = isEn ? 'This field is required.' : 'هذا الحقل مطلوب';
        wrap.querySelectorAll('.field-validation-error, [data-valmsg-for]').forEach(function (el) {
            var t = el.textContent.trim();
            if (t === 'Field is required' || t === 'The field is required.' || t === 'هذا الحقل مطلوب') {
                el.textContent = msg;
            }
        });
        wrap.querySelectorAll('[data-val-required]').forEach(function (el) {
            el.setAttribute('data-val-required', msg);
        });
    }

    document.addEventListener('DOMContentLoaded', applyTranslations);
    setTimeout(applyTranslations, 300);
    setTimeout(applyTranslations, 1000);

    document.addEventListener('DOMContentLoaded', function () {
        var wrap = document.querySelector('.ajb-formWrap');
        if (!wrap) return;
        var obs = new MutationObserver(function () { applyTranslations(); translateValidation(); });
        obs.observe(wrap, { childList: true, subtree: true, characterData: true });
    });
    setTimeout(translateValidation, 1500);
})();
</script>
}
