            @for (var i = 0; i < md_offers.Length; i++)
            {
                var o = md_offers[i];
                <li class="md-offer md-@o.A">
                    <span class="md-oNum" aria-hidden="true">@o.N</span>
                    <div class="md-oBody">
                        <h3 class="md-oTitle">@o.T</h3>
                        <p class="md-oText">@o.B</p>
                    </div>
                    <span class="md-oIcon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            @Html.Raw(mdOfferIcons[i])
                        </svg>
                    </span>
                </li>
            }
        </ul>

        <!-- ── Curriculum highlight ── -->
        <div class="md-curriculum">
            <div class="md-cBody">
                <h3 class="md-cTitle">@md_curTitle</h3>
                <p class="md-cText">@md_curText</p>
            </div>
            <span class="md-oIcon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    @Html.Raw(mdCurIcon)
                </svg>
            </span>
        </div>

        <!-- ── Closing bar ── -->
        <p class="md-closing">
            <svg class="md-deco md-deco--plane" viewBox="0 0 32 24" fill="none" stroke="currentColor"
                 stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M30 2 13 12.5 2 9.5 30 2Z" /><path d="M13 12.5 14.5 21l4-5.5" />
                <path d="M1 18c2.5.6 5 .6 7.5 0" stroke-dasharray="2 3" />
            </svg>
            <span>@md_closing</span>
            <svg class="md-deco md-deco--flower" viewBox="0 0 28 28" fill="none" stroke="currentColor"
                 stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="14" cy="12" r="2.4" />
                <path d="M14 9.6c0-3 1-4.6 2.6-4.6s2 2.2.6 4M11.6 12c-3 0-4.6-1-4.6-2.6s2.2-2 4-.6M14 14.4c0 3-1 4.6-2.6 4.6s-2-2.2-.6-4M16.4 12c3 0 4.6 1 4.6 2.6s-2.2 2-4 .6" />
                <path d="M15 15.5c1.5 3 3 4.5 5 5" stroke-dasharray="2 3" />
            </svg>
        </p>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 2g — Secondary Stage
═══════════════════════════════════════════ -->
<section id="Secondary" class="sc-section">
    <div class="sc-inner">
        <!-- Media first in DOM: RTL puts the artwork on the right, copy on the
             left — alternating against the Intermediate section above. -->
        <div class="sc-media">
            <img src="~/images/secondary-banner.jpg" alt="@(isEn ? "" : sc_title)" class="sc-banner" />
        </div>

        <div class="sc-copy">
            @if (isEn)
            {
                <h2 class="sc-titleText">@sc_title</h2>
            }
            else
            {
                @* The artwork carries the ثانوية دالات lettering. *@
                <h2 class="sc-srOnly">@sc_title</h2>
            }

            <p class="sc-tagline">@sc_tagline</p>
            <p class="sc-lead">@sc_lead</p>

            <div class="sc-blocks">
                @foreach (var blk in sc_blocks)
                {
                    <article class="sc-block">
                        <h3 class="sc-blockName">@blk.Name</h3>
                        @if (blk.AsList)
                        {
                            <ul class="sc-points">
                                @foreach (var line in blk.Body)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        }
                        else
                        {
                            @foreach (var line in blk.Body)
                            {
                                <p class="sc-blockText">@line</p>
                            }
                        }
                    </article>
                }
            </div>

            <p class="sc-closing">@sc_closing</p>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 2h — Activities
═══════════════════════════════════════════ -->
<section id="Activities" class="ac-section">
    <div class="ac-inner">
        <!-- Copy first in DOM: RTL puts it on the right and the artwork on the
             left — alternating against the Secondary section above. -->
        <div class="ac-copy">
            @if (isEn)
            {
                <h2 class="ac-titleText">@ac_title</h2>
            }
            else
            {
                @* The artwork carries the نشاطات دالات lettering. *@
                <h2 class="ac-srOnly">@ac_title</h2>
            }

            <p class="ac-lead">@ac_lead</p>

            <p class="ac-daysLabel">@ac_daysLabel</p>
            <ul class="ac-days">
                @foreach (var (day, what) in ac_days)
                {
                    <li class="ac-day">
                        <span class="ac-dayName">@day</span>
                        <span class="ac-dayText">@what</span>
                    </li>
                }
            </ul>

            <p class="ac-para">@ac_variety</p>
            <p class="ac-para ac-closing">@ac_closing</p>
        </div>

        <div class="ac-media">
            <img src="~/images/activities-banner.jpg" alt="@(isEn ? "" : ac_title)" class="ac-banner" />
        </div>
    </div>
</section>
<!-- ═══════════════════════════════════════════
     SECTION 3 — Facilities (banner toggles the gallery below it)
═══════════════════════════════════════════ -->
<section id="Facilities" class="fc-section">
    <button type="button"
            class="fc-banner"
            id="fcBannerBtn"
            aria-expanded="true"
            aria-controls="fcGallery">
        <img src="~/images/facilities-decor-start.png" alt="" class="fc-decor" />

        <span class="fc-copy">
            <img src="~/logos/dalat-logo.png" alt="دالات" class="fc-logo" />
            @if (isEn)
            {
                <span class="fc-titleText">@fc_title</span>
            }
            else
            {
                <img src="~/images/facilities-title-ar.png" alt="@fc_title" class="fc-titleImg" />
            }
            <span class="fc-hint">
                @fc_hint
                <svg class="fc-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor"
                          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </span>

        <img src="~/images/facilities-girl.png" alt="" class="fc-photo" />
    </button>

    <!-- Open by default; the banner button collapses/expands it. -->
    <div class="fc-gallery" id="fcGallery">
        <div class="fc-track" id="fcTrack">
            @foreach (var shot in facilityShots)
            {
                <figure class="fc-slide">
                    <img src="@shot.Image" alt="@shot.Caption" class="fc-slideImg" loading="lazy" />
                    <figcaption class="fc-caption">@shot.Caption</figcaption>
                </figure>
            }
        </div>

        <button type="button" class="fc-nav fc-navPrev" id="fcPrev"
                aria-label="@(isEn ? "Previous" : "السابق")">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor"
                      stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <button type="button" class="fc-nav fc-navNext" id="fcNext"
                aria-label="@(isEn ? "Next" : "التالي")">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor"
                      stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="fc-dots" id="fcDots" role="tablist"
             aria-label="@(isEn ? "Gallery slides" : "شرائح المعرض")"></div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 4 — Admission & Registration
═══════════════════════════════════════════ -->
<section id="Admission-and-registration" class="rg-registrationSection">
    <div class="rg-header">
        <h2 class="rg-title">@rg_title</h2>
        <p  class="rg-subtitle">@rg_subtitle</p>
    </div>

    <div class="rg-cardsContainer">
        <!-- Card 1: Student Registration -->
        <div class="rg-card">
            <img src="~/icons/story.svg" alt="Student Registration" class="rg-icon" />
            <p class="rg-contact" style="color:#667eea; font-weight:600;">@rg_studTitle</p>
            <p  class="rg-cardText" style="text-align:@textAlign">@rg_studText</p>
            <p  class="rg-contact">0533349899 📞</p>
        </div>

        <!-- Card 2: Join Team -->
        <div class="rg-card">
            <img src="~/icons/teacher.svg" alt="Join Team" class="rg-icon" />
            <h3 class="rg-cardTitle">@rg_joinTitle</h3>
            <p  class="rg-cardText" style="text-align:@textAlign">@rg_joinText</p>
            <p  class="rg-contact" style="color:#667eea; font-weight:600;">
                dalatedu@@gmail.com
            </p>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function () {
    var banner = document.getElementById('fcBannerBtn');
    var gallery = document.getElementById('fcGallery');
    var track = document.getElementById('fcTrack');
    var dotsBox = document.getElementById('fcDots');
    var prev = document.getElementById('fcPrev');
    var next = document.getElementById('fcNext');
    if (!banner || !gallery || !track) return;

    var slides = Array.prototype.slice.call(track.querySelectorAll('.fc-slide'));
    if (!slides.length) return;

    // Gallery starts open (markup ships expanded); the banner toggles it shut.

    // ── Dots ──────────────────────────────────────────────
    var dots = slides.map(function (slide, i) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'fc-dot';
        d.setAttribute('role', 'tab');
        d.setAttribute('aria-label', String(i + 1));
        d.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        d.addEventListener('click', function () { go(i); });
        dotsBox.appendChild(d);
        return d;
    });

    function go(i) {
        i = Math.max(0, Math.min(slides.length - 1, i));
        // scrollIntoView sidesteps RTL scrollLeft sign differences between browsers.
        slides[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // Nearest slide to the viewport centre of the track wins.
    function current() {
        var box = track.getBoundingClientRect();
        var mid = box.left + box.width / 2;
        var best = 0, bestGap = Infinity;
        slides.forEach(function (s, i) {
            var r = s.getBoundingClientRect();
            var gap = Math.abs(r.left + r.width / 2 - mid);
            if (gap < bestGap) { bestGap = gap; best = i; }
        });
        return best;
    }

    function sync() {
        var i = current();
        dots.forEach(function (d, n) {
            d.setAttribute('aria-selected', n === i ? 'true' : 'false');
        });
        prev.disabled = i === 0;
        next.disabled = i === slides.length - 1;
    }

    // fc-navPrev/Next sit on physical sides, so in RTL they step the other way.
    function isRtl() {
        return getComputedStyle(track).direction === 'rtl';
    }
    prev.addEventListener('click', function () { go(current() + (isRtl() ? 1 : -1)); });
    next.addEventListener('click', function () { go(current() + (isRtl() ? -1 : 1)); });

    var tick;
    track.addEventListener('scroll', function () {
        clearTimeout(tick);
        tick = setTimeout(sync, 90);
    }, { passive: true });

    track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { go(current() + (isRtl() ? -1 : 1)); e.preventDefault(); }
        if (e.key === 'ArrowLeft')  { go(current() + (isRtl() ? 1 : -1)); e.preventDefault(); }
    });
    track.tabIndex = 0;

    // ── Banner toggle ─────────────────────────────────────
    banner.addEventListener('click', function () {
        var open = banner.getAttribute('aria-expanded') === 'true';
        banner.setAttribute('aria-expanded', open ? 'false' : 'true');
        gallery.hidden = open;
        if (!open) {
            sync();
            gallery.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    });

    window.addEventListener('resize', sync);
    sync();
})();

// ── Curricula stage carousel (auto-advances every 5s) ─────────
(function () {
    var track = document.getElementById('cuTrack');
    var dotsBox = document.getElementById('cuDots');
    if (!track || !dotsBox) return;

    var slides = Array.prototype.slice.call(track.querySelectorAll('.cu-stage'));
    if (slides.length < 2) return;

    var DELAY = 5000;

    var dots = slides.map(function (slide, i) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'cu-dot';
        d.setAttribute('role', 'tab');
        d.setAttribute('aria-label', String(i + 1));
        d.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        d.addEventListener('click', function () { go(i); restart(); });
        dotsBox.appendChild(d);
        return d;
    });

    function go(i) {
        var target = slides[(i + slides.length) % slides.length];
        // Deliberately NOT scrollIntoView: that scrolls every scrollable ancestor,
        // so an auto-advance would yank the page back to this section from wherever
        // the reader had scrolled to. scrollBy with a measured delta moves only the
        // track, and measuring in client coords sidesteps the RTL scrollLeft sign
        // differences between browsers.
        var t = target.getBoundingClientRect();
        var c = track.getBoundingClientRect();
        var delta = (t.left + t.width / 2) - (c.left + c.width / 2);
        if (Math.abs(delta) < 1) return;
        track.scrollBy({ left: delta, behavior: still ? 'auto' : 'smooth' });
    }

    // Nearest slide to the track's centre wins.
    function current() {
        var box = track.getBoundingClientRect();
        var mid = box.left + box.width / 2;
        var best = 0, bestGap = Infinity;
        slides.forEach(function (s, i) {
            var r = s.getBoundingClientRect();
            var gap = Math.abs(r.left + r.width / 2 - mid);
            if (gap < bestGap) { bestGap = gap; best = i; }
        });
        return best;
    }

    function sync() {
        var i = current();
        dots.forEach(function (d, n) {
            d.setAttribute('aria-selected', n === i ? 'true' : 'false');
        });
        // Offscreen slides are deliberately left in the a11y tree: they stay
        // reachable by scrolling, so aria-hidden would hide real content.
    }

    // Honour reduced-motion: still navigable, just never moves on its own.
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = null;
    var hovering = false;
    // Only run while the carousel is actually on screen — no IntersectionObserver
    // means we can't tell, so fall back to always-on.
    var onScreen = !('IntersectionObserver' in window);

    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() {
        if (still || timer || hovering || document.hidden || !onScreen) return;
        timer = setInterval(function () { go(current() + 1); }, DELAY);
    }
    function restart() { stop(); start(); }

    if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
            onScreen = entries[0].isIntersecting;
            if (onScreen) { start(); } else { stop(); }
        }, { threshold: 0.4 }).observe(track);
    }

    // Don't advance out from under someone reading or interacting.
    function hold()    { hovering = true;  stop(); }
    function release() { hovering = false; start(); }

    ['pointerenter', 'focusin'].forEach(function (e) { track.addEventListener(e, hold); });
    ['pointerleave', 'focusout'].forEach(function (e) { track.addEventListener(e, release); });
    dotsBox.addEventListener('pointerenter', hold);
    dotsBox.addEventListener('pointerleave', release);
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { stop(); } else { start(); }
    });

    var tick;
    track.addEventListener('scroll', function () {
        clearTimeout(tick);
        tick = setTimeout(sync, 90);
    }, { passive: true });

    track.addEventListener('keydown', function (e) {
        var rtl = getComputedStyle(track).direction === 'rtl';
        if (e.key === 'ArrowRight') { go(current() + (rtl ? -1 : 1)); restart(); e.preventDefault(); }
        if (e.key === 'ArrowLeft')  { go(current() + (rtl ? 1 : -1)); restart(); e.preventDefault(); }
    });
    track.tabIndex = 0;

    window.addEventListener('resize', sync);
    sync();
    start();
})();
</script>
}
