@model Umbraco.Cms.Core.Models.ContentModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Read language preference from cookie; default to Arabic
    var lang = Context.Request.Cookies["lang"] ?? "ar";
    if (lang != "ar" && lang != "en") lang = "ar";
    var isEn = lang == "en";
    var dir  = isEn ? "ltr" : "rtl";
    ViewData["Lang"] = lang;
    ViewData["Dir"]  = dir;
    ViewData["Title"] = isEn
        ? "Dalat National Schools — Al-Aarid, Riyadh"
        : "مدارس دالات الأهلية | الرياض – حي العارض";
    ViewData["Description"] = isEn
        ? "Dalat National Schools for girls in Al-Aarid, north Riyadh — kindergarten through secondary, with small classes, a bilingual curriculum, and a safe, healthy learning environment."
        : "مدارس دالات الأهلية للبنات في حي العارض شمال الرياض — من رياض الأطفال حتى الثانوية، بفصول محدودة العدد ومنهج ثنائي اللغة وبيئة تعليمية آمنة وصحية.";

    // Hero photo: use the students photo once it is added, otherwise the illustration
    string heroSrc = "/icons/hero.svg";
    var heroPhoto  = System.IO.Path.Combine(WebHostEnv.WebRootPath, "images", "hero-students.png");
    if (System.IO.File.Exists(heroPhoto)) heroSrc = "/images/hero-students.png";


    // ── translations ──────────────────────────────────────────
    // pageHeader
    var ph_welcome     = isEn ? "Welcome to Dalat National Schools" : "مرحبًا بكم في مدارس دالات الأهلية";
    var ph_register    = isEn ? "Register"                          : "التسجيل";

    // story
    var st_title = isEn ? "The Dalat Story" : "قصة دالات";

    // Headings for the story items. The source copy is four flowing paragraphs
    // with no headings of their own — these summarise each one so the design's
    // titled-item layout has something to show.
    var storyHeads = isEn
        ? new[] { "A vision, first", "A second home", "Three foundations", "Success, measured wider" }
        : new[] { "البداية… رؤية تربوية", "بيت تعليمي ثانٍ", "ثلاث دعائم أساسية", "نجاح بمعنى أوسع" };

    var storyParas = isEn
        ? new[]
        {
            "Dalat was born from the vision of two educational supervisors who spent years in supervision and educational leadership, and saw first-hand how much a young girl needs a different kind of learning environment — a calm, safe one, away from crowding and noise, that gives her reassurance and confidence every school day.",
            "And so Dalat came to be… more than a school; a second educational home, where a student feels safe and feels she belongs from the moment she walks in. We made a point of keeping the number of students smaller, of a healthy and well-prepared building that invites comfort and calm, and of qualified Saudi teachers who believe that building character matters no less than building knowledge.",
            "Dalat rests on three foundations: a safe learning environment, a healthy and well-prepared building, and educational programmes that grow self-confidence, strengthen character and build skills — in genuine partnership with the family.",
            "At Dalat, we do not measure success by academic achievement alone. We create an environment where a student grows with confidence, learns in calm, takes part boldly and discovers the best in herself — to step towards her future with steadiness and distinction.",
        }
        : new[]
        {
            "وُلدت دالات من رؤية اثنين من المشرفين التربويين، عملا لسنوات في الإشراف والقيادة التربوية، وشاهدا عن قرب حاجة الطفلة والطالبة إلى بيئة تعليمية مختلفة؛ بيئة هادئة وآمنة، بعيدة عن الازدحام والضجيج، تمنحها الطمأنينة والثقة في كل يوم دراسي.",
            "ومن هنا جاءت دالات… لتكون أكثر من مدرسة؛ بيتًا تعليميًا ثانيًا، تشعر فيه الطالبة بالأمان والانتماء منذ لحظة دخولها. حرصنا على أن يكون عدد الطالبات أقل، وأن يكون المبنى صحيًا ومهيأً، يبعث على الراحة والهدوء، وأن تتولى تعليمهن معلمات سعوديات مؤهلات، يؤمنَّ بأن بناء الشخصية لا يقل أهمية عن بناء المعرفة.",
            "وترتكز دالات على ثلاث دعائم أساسية: بيئة تعليمية آمنة، ومبنى صحي مهيأ، وبرامج تربوية وتعليمية تنمّي الثقة بالنفس، وتعزز الشخصية، وتبني المهارات، في شراكة حقيقية مع الأسرة.",
            "وفي دالات، لا نقيس النجاح بالتحصيل العلمي وحده، بل نصنع بيئة تنمو فيها الطالبة بثقة، وتتعلّم بهدوء، وتشارك بجرأة، وتكتشف أفضل ما لديها؛ لتخطو نحو مستقبلها بثبات وتميز.",
        };

