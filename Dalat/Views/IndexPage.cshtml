     SECTION 2e — Primary Stage
═══════════════════════════════════════════ -->
<section id="Primary" class="pr-section">
    <div class="pr-inner">
        <!-- Media first in DOM: RTL puts the artwork on the right, copy on the
             left — beside each other, alternating against Kindergarten above. -->
        <div class="pr-media">
            <img src="~/images/primary-banner.jpg" alt="@(isEn ? "" : pr_title)" class="pr-banner" />
        </div>

        <div class="pr-copy">
        @if (isEn)
        {
            <h2 class="pr-titleText">@pr_title</h2>
        }
        else
        {
            @* The artwork carries the ابتدائية دالات lettering. *@
            <h2 class="pr-srOnly">@pr_title</h2>
        }

            <p class="pr-tagline">@pr_tagline</p>
            <p class="pr-lead">@pr_lead</p>

            <div class="pr-blocks">
                @foreach (var blk in pr_blocks)
                {
                    <article class="pr-block">
                        <h3 class="pr-blockName">@blk.Name</h3>
                        @if (blk.AsList)
                        {
                            <ul class="pr-points">
                                @foreach (var line in blk.Body)
