<!-- ═══════════════════════════════════════════
     SECTION 2b — The Dalat Story
═══════════════════════════════════════════ -->
@{
    // Thin-stroke icons matching the reference design's badge treatment.
    var storyIcons = new[]
    {
        // idea / vision
        "<path d='M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.3.2.5.6.5 1V16h6v-1.1c0-.4.2-.8.5-1A6 6 0 0 0 12 3Z'/>",
        // home
        "<path d='M3 10.5 12 3l9 7.5'/><path d='M5.5 9.5V20h13V9.5'/><path d='M9.5 20v-5.5h5V20'/>",
        // three pillars
        "<path d='M3 20h18M4 20V9m6 11V9m10 11V9M2 9h20L12 3 2 9Z'/>",
        // spark / growth
        "<path d='M12 3v4M12 17v4M4.9 7.5l2.9 2.9M16.2 13.6l2.9 2.9M3 12h4M17 12h4M4.9 16.5l2.9-2.9M16.2 10.4l2.9-2.9'/>",
    };
}

<section id="Story" class="st-section">
    <div class="st-inner">
        <!-- Copy first in DOM: RTL puts it on the right and the artwork on the
             left, matching the reference; mirrors cleanly in English. -->
        <div class="st-copy">
            @* The artwork carries the قصة دالات lettering, so Arabic only needs the
               heading for the document outline; English needs a visible one. *@
            @if (isEn)
            {
                <h2 class="st-titleText">@st_title</h2>
                <span class="st-rule" aria-hidden="true"></span>
            }
            else
            {
                <h2 class="st-srOnly">@st_title</h2>
            }

            <ul class="st-list">
                @for (var i = 0; i < storyParas.Length; i++)
                {
                    <li class="st-item">
                        @* Badge first in DOM: RTL puts it at the start (right). *@
                        <span class="st-badge" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                @Html.Raw(storyIcons[i])
                            </svg>
                        </span>
                        <div class="st-itemBody">
                            <h3 class="st-itemTitle">@storyHeads[i]</h3>
                            <p class="st-itemText">@storyParas[i]</p>
                        </div>
                    </li>
                }
            </ul>

            <a href="/#Facilities" class="st-cta">
                <span>@(isEn ? "Explore our facilities" : "اكتشف مرافق دالات")</span>
                <svg class="st-ctaArrow" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
            </a>
        </div>

        <div class="st-media">
            <!-- The full artwork, uncropped. Its cream matches the section, so the
                 space above and below it inside the column reads as page, not gap. -->
            <img src="~/images/story-banner.jpg" alt="@(isEn ? "" : st_title)" class="st-banner" />
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 2c — Our Curricula
═══════════════════════════════════════════ -->
<section id="Curricula" class="cu-section">
    <div class="cu-inner">
        <!-- Media first in DOM: RTL puts it on the right, copy on the left,
             as requested. Mirrors in English. -->
        <div class="cu-media">
            <img src="~/images/curricula-banner.jpg" alt="@(isEn ? "" : cu_title)" class="cu-banner" />
        </div>

        <div class="cu-copy">
            @if (isEn)
            {
                <h2 class="cu-titleText">@cu_title</h2>
            }
            else
            {
                @* The artwork carries the مناهج دالات lettering. *@
                <h2 class="cu-srOnly">@cu_title</h2>
            }

            <p class="cu-lead">@cu_lead</p>

            <ul class="cu-chips">
                @foreach (var chip in cu_chips)
                {
                    <li class="cu-chip">@chip</li>
                }
            </ul>

            <div class="cu-carousel">
                <div class="cu-track" id="cuTrack" role="region"
                     aria-roledescription="@(isEn ? "carousel" : "شرائح متتابعة")"
                     aria-label="@(isEn ? "Curricula by stage" : "المناهج حسب المرحلة")">
                    @* Highlights lead the carousel — the overview before the detail. *@
                    <article class="cu-stage cu-highlights">
                        <h3 class="cu-stageName">@cu_highlightsTitle</h3>
                        <ul class="cu-points">
                            @foreach (var hl in cu_highlights)
                            {
                                <li>@hl</li>
                            }
                        </ul>
                    </article>

                    @foreach (var stage in cu_stages)
                    {
                        <article class="cu-stage">
                            <h3 class="cu-stageName">@stage.Name</h3>
                            <ul class="cu-points">
                                @foreach (var pt in stage.Points)
                                {
                                    <li>@pt</li>
                                }
                            </ul>
                        </article>
                    }
                </div>

                <div class="cu-dots" id="cuDots" role="tablist"
                     aria-label="@(isEn ? "Choose a stage" : "اختيار المرحلة")"></div>
            </div>
        </div>
    </div>
</section>


