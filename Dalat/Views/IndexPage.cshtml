        (Image: "/images/facilities/activity-hall.jpg",
         Caption: isEn ? "Activity Hall"          : "قاعة الأنشطة"),
        (Image: "/images/facilities/playground.jpg",
         Caption: isEn ? "Playground"             : "ساحة اللعب"),
        (Image: "/images/facilities/corridor-mural.jpg",
