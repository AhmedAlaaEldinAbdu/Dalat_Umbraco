        (Image: "/images/facilities/atrium.jpg",
         Caption: isEn ? "Central Atrium"         : "الفناء الداخلي"),
        (Image: "/images/facilities/corridor-upper.jpg",
         Caption: isEn ? "Upper Floor Corridor"   : "ممر الدور العلوي"),
    };

    // registration
    var rg_title       = isEn ? "Be part of Dalat"                             : "كوني جزءًا من دالات";
    var rg_subtitle    = isEn ? "Here, opportunities are created, and journeys begin with confidence"
                               : "هنا تُصنع الفرص، وتبدأ الرحلات بثقة";
    var rg_joinTitle   = isEn ? "Join our team"              : "للانضمام إلى فريق العمل";
    var rg_joinText    = isEn ? "If you believe that education is a mission, and you're looking for an environment that values your dedication… send your CV to the following email:"
                               : "إذا كنتِ ممن يؤمن بأن التعليم رسالة، ونبحث عن بيئة تُقدّر عطائك… أرسلي سيرتك الذاتية على البريد التالي:";
    var rg_studTitle   = isEn ? "Register Now"               : "سجل الآن";
    var rg_studText    = isEn ? "We receive registration requests from parents wishing to schedule an introductory meeting. Contact us via WhatsApp:"
                               : "كما نستقبل طلبات التسجيل من أولياء الأمور الراغبين في حجز مقابلة تعريفية، من خلال التواصل على واتساب :";

    // text alignment
    var textAlign = isEn ? "left" : "right";
