@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ApplyForAjob>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ── Language ──────────────────────────────────────────────
    var lang = Context.Request.Cookies["lang"] ?? "ar";
    if (lang != "ar" && lang != "en") lang = "ar";
    var isEn = lang == "en";
    var dir  = isEn ? "ltr" : "rtl";

    // ar-SA for dictionary translations (matches Umbraco language config)
    // ar-EG is NOT used — it breaks dictionary lookups saved under ar-SA
    var culture = isEn ? "en-US" : "ar-SA";

    ViewData["Lang"]  = lang;
    ViewData["Dir"]   = dir;

    // ── Read properties with culture fallback ─────────────────
    var pageTitle  = Model.Value<string>("pageTitle",  culture: culture)
                  ?? Model.PageTitle
                  ?? (isEn ? "Apply for a Job" : "التقديم على وظيفة");

    var shortBrief = Model.Value<Umbraco.Cms.Core.Strings.IHtmlEncodedString>("shortBrief", culture: culture)
                  ?? Model.ShortBrief;

    var formTitle  = Model.Value<string>("formTitle",  culture: culture)
                  ?? Model.FormTitle
                  ?? (isEn ? "Job Application Form" : "نموذج التقديم على وظيفة");

    var formDesc   = Model.Value<string>("formDescription", culture: culture)
                  ?? Model.FormDescription
                  ?? (isEn ? "Fill in the form below and we will get back to you shortly."
                           : "يُرجى تعبئة النموذج أدناه وسنتواصل معك في أقرب وقت.");

    var nafath = Model.ProtectedByNafath;

    ViewData["Title"] = pageTitle + (isEn ? " – Dalat School" : " – مدارس دالات");
}

<!-- ═══════════════════════════════════════════
     PAGE HEADER
═══════════════════════════════════════════ -->
<section class="ajb-header" dir="@dir">
    <div class="ajb-headerInner">
        <h1 class="ajb-pageTitle">@pageTitle</h1>
        @if (shortBrief != null)
        {
            <div class="ajb-pageSubtitle">@shortBrief</div>
        }
    </div>
</section>

<!-- ═══════════════════════════════════════════
     FORM CARD
═══════════════════════════════════════════ -->
<section class="ajb-section" dir="@dir">
    <div class="ajb-card">

        @if (!string.IsNullOrWhiteSpace(formTitle) || !string.IsNullOrWhiteSpace(formDesc))
        {
            <div class="ajb-formHeading" style="text-align:@(isEn ? "left" : "right")">
                @if (!string.IsNullOrWhiteSpace(formTitle))
                {
                    <h2 class="ajb-formTitle">@formTitle</h2>
                }
                @if (!string.IsNullOrWhiteSpace(formDesc))
                {
                    <p class="ajb-formDesc">@formDesc</p>
                }
            </div>
        }

        @if (nafath)
        {
            <div class="ajb-nafath">
                <img src="~/images/nafath-logo.png" alt="Nafath" class="ajb-nafathImg" />
                <span>@(isEn ? "This form is protected by Nafath" : "هذا النموذج محمي بنفاذ")</span>
            </div>
        }

        <div class="ajb-formWrap">
            @if (Model.FormRef.HasValue)
            {
                @await Component.InvokeAsync("RenderForm", new
                {
                    formId         = Model.FormRef.Value,
                    theme          = "default",
                    includeScripts = true,
                    culture        = culture
                })
            }
            else
            {
                <p class="ajb-noForm">
                    @(isEn
                        ? "The application form is currently unavailable. Please try again later."
                        : "نموذج التقديم غير متاح حالياً. يُرجى المحاولة لاحقاً.")
                </p>
            }
        </div>

    </div>
</section>

@section Scripts {
<script>
// Override moment Arabic locale to use Gregorian month names (not Hijri)
(function () {
    function patchMoment() {
        if (typeof moment === 'undefined') { setTimeout(patchMoment, 100); return; }
        var arMonths = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
        moment.updateLocale('ar', { months: arMonths, monthsShort: arMonths });
    }
    patchMoment();
})();
</script>

@if (!isEn)
{
<script>
(function translateForm() {

    // ── Field labels ──────────────────────────────────────────────────────
    var labels = {
        // Personal
        'First Name'              : 'الاسم الأول',
        'FIRST NAME'              : 'الاسم الأول',
        'Middle Name'             : 'الاسم الأوسط',
        'MIDDLE NAME'             : 'الاسم الأوسط',
        'Last Name'               : 'اسم العائلة',
        'LAST NAME'               : 'اسم العائلة',
        'Gender'                  : 'الجنس',
        'GENDER'                  : 'الجنس',
        'National ID Number'      : 'رقم الهوية الوطنية',
        'NATIONAL ID NUMBER'      : 'رقم الهوية الوطنية',
        'birthDate'               : 'تاريخ الميلاد',
        'Birth Date'              : 'تاريخ الميلاد',
        'BIRTH DATE'              : 'تاريخ الميلاد',
        // Contact
        'Email Address'           : 'البريد الإلكتروني',
        'EMAIL ADDRESS'           : 'البريد الإلكتروني',
        'Email'                   : 'البريد الإلكتروني',
        'EMAIL'                   : 'البريد الإلكتروني',
        'Phone Number'            : 'رقم الهاتف',
        'PHONE NUMBER'            : 'رقم الهاتف',
        'Phone number'            : 'رقم الهاتف',
        'Mobile Number'           : 'رقم الجوال',
        'MOBILE NUMBER'           : 'رقم الجوال',
        'Mobile number'           : 'رقم الجوال',
        'Address'                 : 'العنوان',
        'ADDRESS'                 : 'العنوان',
        'City'                    : 'المدينة',
        'CITY'                    : 'المدينة',
        'Country'                 : 'الدولة',
        'COUNTRY'                 : 'الدولة',
        // Section headings
        'Personal Information'    : 'المعلومات الشخصية',
        'PERSONAL INFORMATION'    : 'المعلومات الشخصية',
        'Contact Information'     : 'معلومات التواصل',
        'CONTACT INFORMATION'     : 'معلومات التواصل',
        'Professional Information' : 'المعلومات المهنية',
        'PROFESSIONAL INFORMATION' : 'المعلومات المهنية',
        'Additional Information'  : 'معلومات إضافية',
        'ADDITIONAL INFORMATION'  : 'معلومات إضافية',
        // Submit
        'Submit'                  : 'إرسال',
        'SUBMIT'                  : 'إرسال',
        'Send'                    : 'إرسال',
        // Dropdown options
        'Male'                    : 'ذكر',
        'Female'                  : 'أنثى',
        'Please select'           : 'اختر...',
        '-- Select --'            : 'اختر...',
        'Select'                  : 'اختر...'
    };

    // ── Placeholders ──────────────────────────────────────────────────────
    var placeholders = {
        'Enter your first name'   : 'أدخل اسمك الأول',
        'Enter your middle name'  : 'أدخل اسمك الأوسط',
        'Enter your last name'    : 'أدخل اسم العائلة',
        'Enter your ID Number'    : 'أدخل رقم الهوية',
        'Example: mail@domain.com': 'مثال: mail@domain.com',
        'Enter your mobile number': 'أدخل رقم جوالك',
        'Enter your phone number' : 'أدخل رقم هاتفك',
        'Enter your address'      : 'أدخل عنوانك',
        'Enter your city'         : 'أدخل مدينتك'
    };

    function translateText(map, text) {
        if (!text) return null;
        var t = text.trim();
        return map[t] || null;
    }

    function applyTranslations() {
        var wrap = document.querySelector('.ajb-formWrap');
        if (!wrap) return;

        // Labels — handle text node + optional mandatory indicator span
        wrap.querySelectorAll('label').forEach(function (el) {
            el.childNodes.forEach(function (node) {
                if (node.nodeType === 3) {
                    var ar = translateText(labels, node.textContent);
                    if (ar) node.textContent = node.textContent.replace(node.textContent.trim(), ar);
                }
            });
        });

        // Fieldset legends / section headings
        wrap.querySelectorAll('legend, .umbraco-forms-fieldset-legend, h3, h4, [class*="caption"], [class*="heading"]').forEach(function (el) {
            var ar = translateText(labels, el.textContent);
            if (ar) el.textContent = ar;
        });

        // Umbraco Forms label spans
        wrap.querySelectorAll('.umbraco-forms-label, .field-label').forEach(function (el) {
            var txt = el.childNodes[0];
            if (txt && txt.nodeType === 3) {
                var ar = translateText(labels, txt.textContent);
                if (ar) txt.textContent = ar;
            }
        });

        // Placeholders
        wrap.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(function (el) {
            var ar = translateText(placeholders, el.getAttribute('placeholder'));
            if (ar) el.setAttribute('placeholder', ar);
        });

        // Dropdown <option> values
        wrap.querySelectorAll('select option').forEach(function (el) {
            var ar = translateText(labels, el.textContent);
            if (ar) el.textContent = ar;
        });

        // Submit button
        wrap.querySelectorAll('input[type="submit"]').forEach(function (el) {
            var ar = translateText(labels, el.value);
            if (ar) el.value = ar;
        });
        wrap.querySelectorAll('button[type="submit"], button.btn').forEach(function (el) {
            var ar = translateText(labels, el.textContent);
            if (ar) el.textContent = ar;
        });

        // RTL direction
        wrap.setAttribute('dir', 'rtl');
    }

    document.addEventListener('DOMContentLoaded', applyTranslations);
    setTimeout(applyTranslations, 300);
    setTimeout(applyTranslations, 1000);
})();
</script>
}
}
