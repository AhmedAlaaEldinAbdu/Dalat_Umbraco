  "markup": "\u003Cp\u003E\u003Cspan data-asw-orgfontsize=\u002216\u0022 style=\u0022box-sizing: border-box; font-size: 16px; line-height: 19.2px; font-family: \u0026quot;IBM Plex Sans Arabic\u0026quot;, sans-serif !important; font-weight: 400 !important; color: rgb(22, 22, 22) !important; text-align: unset !important;\u0022\u003E\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642\u0631\u0628 \u0627\u0646\u062A\u0647\u0627\u0621 \u0627\u0644\u0645\u0647\u0644\u0629 \u0627\u0644\u0645\u062D\u062F\u062F\u0629 \u0644\u0644\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u0639\u064A\u0646\u064A \u0627\u0644\u0623\u0648\u0644 \u0644\u0644\u0639\u0642\u0627\u0631 \u0644\u0640 (459,515) \u0642\u0637\u0639\u0629 \u0639\u0642\u0627\u0631\u064A\u0629 \u0641\u064A \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0631\u064A\u0627\u0636 \u0648\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629 \u0648\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0645\u0646\u0648\u0631\u0629\u060C \u0648\u0630\u0644\u0643 \u0628\u0646\u0647\u0627\u064A\u0629 \u064A\u0648\u0645 \u0627\u0644\u062E\u0645\u064A\u0633 3 \u0645\u062D\u0631\u06451448\u0647\u0640\u060C \u0627\u0644\u0645\u0648\u0627\u0641\u0642 \u0644\u0640 18 \u064A\u0648\u0646\u064A\u0648 2026\u0645.\u0623\u0639\u0644\u0646\u062A \u0627\u0644\u0647\u064A\u0626\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0639\u0642\u0627\u0631 \u0639\u0646 \u0642